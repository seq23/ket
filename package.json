{
  "name": "ket",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "expo start --offline",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=dot tests/*.test.ts",
    "validate": "bash scripts/validate-repository.sh",
    "check": "npm run typecheck && npm test && npm run validate",
    "preview:web": "expo export --platform web",
    "preview:serve": "expo serve --port 4173",
    "tap-through": "node scripts/tap-through.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.16",
    "expo": "58.0.22",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-router": "~58.0.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "playwright": "1.65.1"
  }
}
